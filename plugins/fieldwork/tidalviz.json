{
  "apiVersion": 1,
  "visualizers": [
    {
      "id": "chladni",
      "name": "Chladni",
      "description": "Sand on a ringing brass plate gathers into the standing-wave figure of each note, hops on kicks and fizzes on hats.",
      "author": "Fieldwork",
      "entry": "src/chladni.js",
      "renderer": "webgl2",
      "thumbnail": "thumbs/chladni.jpg",
      "params": [
        { "id": "palette", "type": "select", "label": "Palette", "options": ["brass", "slate", "cobalt", "mono"], "default": "brass" },
        { "id": "backdrop", "type": "select", "label": "Backdrop", "options": ["plate", "none"], "default": "plate" },
        { "id": "grains", "type": "select", "label": "Grains", "options": ["32k", "64k", "128k"], "default": "64k" },
        { "id": "complexity", "type": "number", "label": "Complexity", "min": 0.5, "max": 2, "step": 0.05, "default": 1 },
        { "id": "reactivity", "type": "number", "label": "Reactivity", "min": 0, "max": 2, "step": 0.05, "default": 1 },
        { "id": "hop", "type": "number", "label": "Hop", "min": 0, "max": 2, "step": 0.05, "default": 1 }
      ]
    }
  ]
}
