{
  "apiVersion": 1,
  "visualizers": [
    {
      "id": "chladni",
      "name": "Chladni",
      "description": "Sand on a ringing brass plate gathers into the standing-wave figure of each note, hops on kicks and fizzes on hats.",
      "author": "Fieldwork",
      "entry": "src/chladni.js",
      "renderer": "webgl2",
      "thumbnail": "thumbs/chladni.jpg",
      "params": [
        { "id": "palette", "type": "select", "label": "Palette", "options": ["brass", "slate", "cobalt", "mono"], "default": "brass" },
        { "id": "backdrop", "type": "select", "label": "Backdrop", "options": ["plate", "none"], "default": "plate" },
        { "id": "grains", "type": "select", "label": "Grains", "options": ["32k", "64k", "128k"], "default": "64k" },
        { "id": "complexity", "type": "number", "label": "Complexity", "min": 0.5, "max": 2, "step": 0.05, "default": 1 },
        { "id": "reactivity", "type": "number", "label": "Reactivity", "min": 0, "max": 2, "step": 0.05, "default": 1 },
        { "id": "hop", "type": "number", "label": "Hop", "min": 0, "max": 2, "step": 0.05, "default": 1 }
      ]
    },
    {
      "id": "murmuration",
      "name": "Murmuration",
      "description": "Thousands of starlings wheel as one silhouette over a dusk sky: kicks squeeze the flock dark, strong hits send a falcon diving through.",
      "author": "Fieldwork",
      "entry": "src/murmuration.js",
      "renderer": "three",
      "libs": ["three"],
      "thumbnail": "thumbs/murmuration.jpg",
      "params": [
        { "id": "sky", "type": "select", "label": "Sky", "options": ["dusk", "overcast", "rose", "none"], "default": "dusk" },
        { "id": "ink", "type": "color", "label": "Ink (sky none)", "default": "#ece6da" },
        { "id": "flock", "type": "select", "label": "Flock size", "options": ["2000", "4000", "6000"], "default": "4000" },
        { "id": "speed", "type": "number", "label": "Speed", "min": 0.2, "max": 2, "step": 0.05, "default": 1 },
        { "id": "falcon", "type": "boolean", "label": "Falcon", "default": true },
        { "id": "reactivity", "type": "number", "label": "Reactivity", "min": 0, "max": 2, "step": 0.05, "default": 1 }
      ]
    }
  ]
}
